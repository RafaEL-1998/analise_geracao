# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Data Directories (Raw data downloaded from external sources)
data/raw/*
!data/raw/.gitkeep

# IDE & OS
.idea/
.vscode/
*.swp
*.bak
Thumbs.db
Desktop.ini

# Backups
_backup_*/

# Arquivos grandes e documentos externos (documentos da usina e de consulta ficam fora do git)
usinas/*/documentos/
referencias/
*.rar
*.zip
*.7z
# Dados processados e brutos locais
data/
# Documentos pesados da raiz (PDFs e Word de normas/relatórios)
*.pdf
*.docx
*.doc
.venv/
.DS_Store
*.tmp
# Relatórios de referência aprovados (spec 006, decisão R22): o PDF entra no git; a Coleta congelada e as pastas
# temporárias do comando referencia, não
!relatorios_referencia/**/*.pdf
relatorios_referencia/*/coleta/
relatorios_referencia/.*/
